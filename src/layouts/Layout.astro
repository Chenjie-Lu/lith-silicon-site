---
import BaseLayout from './BaseLayout.astro';
import { t, getLocale } from '../utils/site';

const locale = getLocale();
const tzh = (key) => t(key, locale);
const langToggle = locale === 'zh' ? 'en' : 'zh';
---

<BaseLayout>
  <slot name="head" />

  <nav class="nav-blur fixed top-0 left-0 right-0 z-50">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <img src="/logo.svg" alt="LiSi" class="h-8 w-auto" />
      </a>

      <div class="hidden md:flex items-center gap-8">
        <a href="/" class="text-slate-400 hover:text-white text-sm font-medium transition-colors">{tzh('nav.home')}</a>
        <a href="/services" class="text-slate-400 hover:text-white text-sm font-medium transition-colors">{tzh('nav.services')}</a>
        <a href="/blog" class="text-slate-400 hover:text-white text-sm font-medium transition-colors">{tzh('nav.blog')}</a>
        <a href="/about" class="text-slate-400 hover:text-white text-sm font-medium transition-colors">{tzh('nav.about')}</a>
        <a href="/contact" class="text-slate-400 hover:text-white text-sm font-medium transition-colors">{tzh('nav.contact')}</a>
        <a href="/privacy" class="text-slate-400 hover:text-white text-sm font-medium transition-colors">{locale === 'zh' ? '隐私政策' : 'Privacy'}</a>
      </div>

      <div class="flex items-center gap-4">
        <a href={`/?lang=${langToggle}`} class="text-slate-500 hover:text-slate-300 text-sm font-medium transition-colors">
          {tzh('common.lang')}
        </a>
        <a href="/contact" class="hidden md:inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-full hover:bg-blue-500 transition-colors no-underline">
          {tzh('contact.title')}
        </a>
        <button onclick="document.getElementById('mobile-menu').classList.toggle('hidden')" class="md:hidden text-slate-400 hover:text-white" aria-label="Toggle menu">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden nav-blur border-t border-white/5">
      <div class="px-6 py-4 flex flex-col gap-3">
        <a href="/" class="text-slate-400 hover:text-white text-sm font-medium">{tzh('nav.home')}</a>
        <a href="/services" class="text-slate-400 hover:text-white text-sm font-medium">{tzh('nav.services')}</a>
        <a href="/blog" class="text-slate-400 hover:text-white text-sm font-medium">{tzh('nav.blog')}</a>
        <a href="/about" class="text-slate-400 hover:text-white text-sm font-medium">{tzh('nav.about')}</a>
        <a href="/contact" class="text-slate-400 hover:text-white text-sm font-medium">{tzh('nav.contact')}</a>
        <a href={`/?lang=${langToggle}`} class="text-slate-500 text-sm mt-2 pt-3 border-t border-white/5">{tzh('common.lang')}</a>
      </div>
    </div>
  </nav>

  <main id="main-content">
    <slot />
  </main>
</BaseLayout>

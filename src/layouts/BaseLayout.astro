<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={Astro.url?.href ?? ''} />
  <title>{Astro.title ?? '锂硅新能'}</title>
  <meta name="description" content={Astro.description ?? '锂硅新能 — 硅碳负极材料技术顾问'} />
  <!-- OG / Social -->
  <meta property="og:site_name" content="锂硅新能 · LixSi Energy" />
  <meta property="og:type" content={Astro.ogType ?? 'website'} />
  <meta property="og:title" content={Astro.title ?? '锂硅新能 — 硅碳负极材料技术顾问'} />
  <meta property="og:description" content={Astro.description ?? '锂硅新能 — 硅碳负极材料技术顾问'} />
  <meta property="og:url" content={Astro.url?.href ?? ''} />
  <meta property="og:image" content="https://lith-silicon.vercel.app/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="zh_CN" />
  <meta property="og:locale:alternate" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={Astro.title ?? '锂硅新能 — 硅碳负极材料技术顾问'} />
  <meta name="twitter:description" content={Astro.description ?? '锂硅新能 — 硅碳负极材料技术顾问'} />
  <meta name="twitter:image" content="https://lith-silicon.vercel.app/og-image.png" />
  <!-- JSON-LD Organization -->
  <script type="application/ld+json" set:html={`{"@context":"https://schema.org","@type":"Organization","name":"杭州锂硅新能源有限公司","alternateName":"LiSi Energy / LixSi","url":"https://lith-silicon.vercel.app","logo":"https://lith-silicon.vercel.app/logo.svg","description":"锂离子电池硅碳负极材料技术顾问，为初创电池企业提供从材料配方到产业化工艺的全流程技术支持","foundingDate":"2023","address":{"@type":"PostalAddress","addressRegion":"浙江省","addressLocality":"杭州市","addressCountry":"CN"}}"}`}>
  </script>
  <link rel="stylesheet" href="/src/styles.css">
  <link href="https://fonts.loli.net/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Noto+Sans+SC:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #070b14;
      --bg-elevated: #0d1321;
      --card: #111827;
      --border: rgba(255,255,255,0.06);
      --border-hover: rgba(59,130,246,0.3);
      --text: #f1f5f9;
      --text-secondary: #94a3b8;
      --text-muted: #475569;
      --accent: #3b82f6;
      --accent-glow: rgba(59,130,246,0.12);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', 'Noto Sans SC', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100vh;
      overflow-x: hidden;
    }
    a { color: inherit; text-decoration: none; }
    ::selection { background: rgba(59,130,246,0.3); color: #fff; }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--text-muted); border-radius: 3px; }

    .skip-link {
      position: absolute; top: -100%; left: 1rem; z-index: 200;
      padding: 0.5rem 1rem; background: var(--accent); color: #fff;
      font-size: 0.875rem; font-weight: 600; border-radius: 0 0 0.5rem 0.5rem; transition: top 0.2s;
    }
    .skip-link:focus { top: 0; }

    @keyframes fade-in-up {
      from { opacity: 0; transform: translateY(32px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }
    .animate-in { animation: fade-in-up 0.7s ease-out forwards; opacity: 0; }
    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.3s; }
    .delay-4 { animation-delay: 0.4s; }
    .delay-5 { animation-delay: 0.5s; }
    .animate-float { animation: float 4s ease-in-out infinite; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
      .animate-in { opacity: 1; animation: none; }
      .animate-float { animation: none; }
      html { scroll-behavior: auto; }
    }

    .grain::after {
      content: '';
      position: fixed; inset: 0; z-index: 50; pointer-events: none;
      opacity: 0.025;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      background-repeat: repeat; background-size: 128px 128px;
    }

    .hover-lift { transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .hover-lift:hover { transform: translateY(-3px); box-shadow: 0 16px 48px rgba(0,0,0,0.4); }

    .nav-blur {
      background: rgba(7,11,20,0.88);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 1rem;
      transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .card:hover { border-color: var(--border-hover); box-shadow: 0 0 40px var(--accent-glow); }
  </style>
  <slot name="head" />
</head>
<body class="antialiased grain">
  <a href="#main-content" class="skip-link">Skip to content</a>
  <slot />
  <script is:inline>
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('animate-in'); });
    }, { threshold: 0.1 });
    document.querySelectorAll('.observe').forEach(el => obs.observe(el));
  </script>
</body>
</html>

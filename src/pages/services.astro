---
import Layout from '../layouts/Layout.astro';
import { t, getLocale, services } from '../utils/site';

const locale = getLocale();
const tzh = (key) => t(key, locale);
export const title = '技术服务 — 锂硅新能';
export const description = '硅碳负极材料配方优化、电化学性能提升、产业化工艺指导等6大技术服务领域';
export const ogType = 'website';
---
<head>
  <title>技术服务 — 锂硅新能</title>
  <meta name="description" content="硅碳负极材料配方优化、电化学性能提升、产业化工艺指导等6大技术服务领域" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="技术服务 — 锂硅新能" />
  <meta property="og:description" content="硅碳负极材料配方优化、电化学性能提升、产业化工艺指导等6大技术服务领域" />
</head>

<Layout>
  <section class="pt-28 pb-20 bg-[#070b14]" id="main-content">
    <div class="max-w-7xl mx-auto px-6">
      <div class="observe">
        <h1 class="text-4xl md:text-6xl font-black text-white mb-4">{tzh('service.title')}</h1>
        <p class="text-slate-400 text-lg max-w-2xl">{tzh('service.subtitle')}</p>
      </div>
    </div>
  </section>

  <section class="py-24 bg-[#070b14]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {services.map((service, i) => (
          <div key={i} class="observe card p-8 hover-lift">
            <div class="flex items-start gap-5">
              <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/20 rounded-xl flex items-center justify-center text-blue-400 shrink-0">
                {i === 0 && <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>}
                {i === 1 && <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>}
                {i === 2 && <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>}
                {i === 3 && <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>}
                {i === 4 && <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>}
                {i === 5 && <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>}
              </div>
              <div>
                <span class="text-slate-600 text-xs font-mono mb-2 block">0{i + 1}</span>
                <h3 class="text-xl font-bold text-white mb-3">{service.zh.title}</h3>
                <p class="text-slate-400 leading-relaxed text-sm">{service.zh.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-32 bg-[#0d1321]">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="observe">
        <h2 class="text-3xl md:text-5xl font-black text-white mb-6">{tzh('about.mission')}</h2>
        <p class="text-slate-400 text-lg mb-10">{tzh('contact.subtitle')}</p>
        <a href="/contact" class="group inline-flex items-center gap-2 px-8 py-4 bg-blue-600 text-white font-semibold rounded-full hover:bg-blue-500 transition-all no-underline">
          {tzh('contact.title')}
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { t, getLocale, services } from '../utils/site';

const locale = getLocale();
const tzh = (key) => t(key, locale);
---

<Layout>
  <section class="pt-28 pb-20 bg-[#070b14]" id="main-content">
    <div class="max-w-7xl mx-auto px-6">
      <div class="observe">
        <h1 class="text-4xl md:text-6xl font-black text-white mb-4">{tzh('about.title')}</h1>
        <p class="text-slate-400 text-lg max-w-2xl">{tzh('about.subtitle')}</p>
      </div>
    </div>
  </section>

  <section class="py-24 bg-[#070b14]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div class="observe">
          <h2 class="text-2xl font-bold text-white mb-6">{locale === 'zh' ? '关于我们' : 'About Us'}</h2>
          <p class="text-slate-400 text-lg leading-relaxed mb-6">
            {locale === 'zh'
              ? '杭州锂硅新能源有限公司成立于2023年，专注于锂离子电池硅碳负极材料的研发与技术服务。核心团队拥有3年以上硅碳/石墨负极开发经验，熟悉材料设计、电化学性能优化及产业化工艺放大等全流程技术环节。'
              : 'Hangzhou LiSi Energy Co., Ltd. was established in 2023, focusing on the R&D and technical services of silicon-carbon anode materials for lithium-ion batteries. The core team has over 3 years of experience in silicon-carbon/graphite anode development.'}
          </p>
          <p class="text-slate-400 text-lg leading-relaxed mb-10">
            {locale === 'zh'
              ? '我们致力于为初创电池企业提供专业的技术解决方案，帮助客户解决研发难题、缩短研发周期、降低试错成本。从材料配方设计到产业化工艺指导，我们提供全方位的技术支持服务。'
              : 'We are committed to providing professional technical solutions for startup battery companies, helping clients solve R&D challenges, shorten development cycles, and reduce trial-and-error costs.'}
          </p>
          <div class="card p-8">
            <h3 class="text-sm font-semibold text-white mb-3">{locale === 'zh' ? '我们的使命' : 'Our Mission'}</h3>
            <p class="text-slate-400 leading-relaxed">
              {locale === 'zh'
                ? '让每一家初创电池企业都能获得专业的负极材料技术支持'
                : 'Enable every startup battery company to access professional anode material technical support'}
            </p>
          </div>
        </div>

        <div class="observe">
          <h2 class="text-2xl font-bold text-white mb-6">{locale === 'zh' ? '核心优势' : 'Core Strengths'}</h2>
          <div class="space-y-4">
            {[
              { zh: '3年+ 研发团队管理经验', en: '3+ Years R&D Management Experience' },
              { zh: '硅碳/石墨负极材料开发', en: 'Silicon-Carbon/Graphite Anode Development' },
              { zh: '材料设计 → 工艺放大 → 问题解决', en: 'Material Design → Process Scale-up → Problem Solving' },
              { zh: '专注于初创电池企业技术赋能', en: 'Focused on Empowering Startup Battery Companies' },
            ].map((item, i) => (
              <div key={i} class="card p-6 flex items-center gap-5 hover-lift">
                <div class="w-10 h-10 bg-blue-500/10 border border-blue-500/20 rounded-xl flex items-center justify-center text-blue-400 font-bold text-sm shrink-0">
                  {i + 1}
                </div>
                <span class="text-white font-medium">{locale === 'zh' ? item.zh : item.en}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

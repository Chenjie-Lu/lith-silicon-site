---
import Layout from '../layouts/Layout.astro';
import { t, getLocale } from '../utils/site';

const locale = getLocale();
const tzh = (key) => t(key, locale);
---

<Layout>
  <section class="pt-28 pb-20 bg-[#070b14]" id="main-content">
    <div class="max-w-7xl mx-auto px-6">
      <div class="observe">
        <h1 class="text-4xl md:text-6xl font-black text-white mb-4">{tzh('contact.title')}</h1>
        <p class="text-slate-400 text-lg">{tzh('contact.subtitle')}</p>
      </div>
    </div>
  </section>

  <section class="py-24 bg-[#070b14]">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div class="observe">
          <h2 class="text-xl font-bold text-white mb-8">{locale === 'zh' ? '联系方式' : 'Contact Information'}</h2>
          <div class="space-y-4">
            <div class="card p-5 flex items-center gap-4">
              <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/20 rounded-xl flex items-center justify-center text-blue-400 shrink-0">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <div class="text-slate-500 text-xs mb-1">{locale === 'zh' ? '邮箱' : 'Email'}</div>
                <a href="mailto:contact@lith-silicon.com" class="text-blue-400 font-medium text-sm hover:text-blue-300 no-underline">contact@lith-silicon.com</a>
              </div>
            </div>

            <div class="card p-5 flex items-center gap-4">
              <div class="w-12 h-12 bg-cyan-500/10 border border-cyan-500/20 rounded-xl flex items-center justify-center text-cyan-400 shrink-0">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              </div>
              <div class="flex-1">
                <div class="text-slate-500 text-xs mb-1">{tzh('contact.wechat')}</div>
                <div class="text-slate-300 text-sm">{locale === 'zh' ? '扫描下方二维码添加微信' : 'Scan QR code below to add WeChat'}</div>
              </div>
              <div class="w-20 h-20 bg-slate-800 border border-white/10 rounded-lg flex items-center justify-center text-xs text-slate-500 text-center p-2">
                {locale === 'zh' ? '微信二维码\n请替换' : 'QR Code\nHere'}
              </div>
            </div>

            <div class="card p-5 flex items-center gap-4">
              <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/20 rounded-xl flex items-center justify-center text-blue-400 shrink-0">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <div class="text-slate-500 text-xs mb-1">{locale === 'zh' ? '地址' : 'Location'}</div>
                <div class="text-slate-200 text-sm">{locale === 'zh' ? '浙江省杭州市' : 'Hangzhou, Zhejiang, China'}</div>
              </div>
            </div>
          </div>
        </div>

        <div class="observe">
          <h2 class="text-xl font-bold text-white mb-8">{locale === 'zh' ? '发送留言' : 'Send a Message'}</h2>
          <form id="contact-form" class="space-y-5">
            <div>
              <label class="block text-slate-400 text-sm mb-2">
                {locale === 'zh' ? '姓名' : 'Name'} <span class="text-red-400">*</span>
              </label>
              <input type="text" name="name" required
                class="w-full px-4 py-3 bg-slate-800/50 border border-white/10 rounded-xl text-white text-sm focus:border-blue-500 transition-colors outline-none"
              />
            </div>
            <div>
              <label class="block text-slate-400 text-sm mb-2">
                {locale === 'zh' ? '公司名称' : 'Company'}
              </label>
              <input type="text" name="company"
                class="w-full px-4 py-3 bg-slate-800/50 border border-white/10 rounded-xl text-white text-sm focus:border-blue-500 transition-colors outline-none"
              />
            </div>
            <div>
              <label class="block text-slate-400 text-sm mb-2">
                {locale === 'zh' ? '邮箱' : 'Email'} <span class="text-red-400">*</span>
              </label>
              <input type="email" name="email" required
                class="w-full px-4 py-3 bg-slate-800/50 border border-white/10 rounded-xl text-white text-sm focus:border-blue-500 transition-colors outline-none"
              />
            </div>
            <div>
              <label class="block text-slate-400 text-sm mb-2">
                {locale === 'zh' ? '留言内容' : 'Message'} <span class="text-red-400">*</span>
              </label>
              <textarea name="message" required rows="5"
                class="w-full px-4 py-3 bg-slate-800/50 border border-white/10 rounded-xl text-white text-sm focus:border-blue-500 transition-colors outline-none resize-none"
              ></textarea>
            </div>
            <button type="submit" class="w-full py-4 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-500 transition-all no-underline">
              {locale === 'zh' ? '提交留言' : 'Send Message'}
              <svg class="w-4 h-4 inline-block ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </form>
          <div id="form-status" class="mt-4 p-4 rounded-xl hidden"></div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form');
    const status = document.getElementById('form-status');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const isEn = locale === 'en';
        try {
          const response = await fetch('https://formsubmit.co/ajax/contact@lith-silicon.com', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
              name: data.get('name'),
              company: data.get('company'),
              email: data.get('email'),
              message: data.get('message'),
              _subject: isEn ? 'New contact from LiSi Energy' : '锂硅新能网站新留言',
            }),
          });
          if (response.ok) {
            status.classList.remove('hidden');
            status.className = 'p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-400 text-sm';
            status.textContent = isEn ? 'Message sent successfully! We will contact you soon.' : '留言发送成功！我们会尽快与您联系。';
            form.reset();
          }
        } catch (err) {
          status.classList.remove('hidden');
          status.className = 'p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm';
          status.textContent = isEn ? 'Failed to send. Please try again or contact us via email.' : '发送失败，请重试或通过邮件联系我们。';
        }
      });
    }
  </script>
</Layout>

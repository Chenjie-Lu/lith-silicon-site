---
import Layout from '../../layouts/Layout.astro';
import { t, getLocale } from '../../utils/site';
import { blogPosts } from '../../data/blog-posts';

const locale = getLocale();
const tzh = (key) => t(key, locale);
const post = blogPosts['silicon-carbon-anode-development-trends-2026'];
const isEn = locale === 'en';
const category = isEn ? post.categoryEn : post.category;
const tags = isEn ? post.tagsEn : post.tags;
const articleContent = isEn ? (post.contentEn || post.content) : post.content;
const postTitle = isEn ? post.titleEn : post.title;

export const getStaticPaths = () => [
  { params: { slug: 'silicon-carbon-anode-development-trends-2026' } },
  { params: { slug: 'choosing-silicon-anode-technology-route-2026' } },
];
---
<head>
  <title>{postTitle}</title>
  <meta name="description" content={isEn ? post.excerptEn : post.excerpt} />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={postTitle} />
  <meta property="og:description" content={isEn ? post.excerptEn : post.excerpt} />
  <meta property="article:published_time" content={post.date} />
  <meta property="article:section" content={category} />
  {tags.map(tag => <meta key={tag} property="article:tag" content={tag} />)}
</head>

<Layout>
  <section class="pt-28 pb-20 bg-white" id="main-content">
    <div class="max-w-4xl mx-auto px-6">
      <div class="observe">
        <a href="/blog" class="inline-flex items-center gap-2 text-blue-400 hover:text-blue-300 text-sm font-medium mb-8 no-underline transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          {tzh('blog.backToBlog')}
        </a>
        <div class="flex items-center gap-3 mb-6 flex-wrap">
          <span class="px-3 py-1.5 bg-blue-500/10 text-blue-400 text-xs font-mono rounded-full border border-blue-500/20">{category}</span>
          <span class="text-slate-500 text-sm font-mono">{post.date}</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-black text-slate-900 leading-tight mb-8">{postTitle}</h1>
        <div class="flex gap-2 flex-wrap">
          {tags.map(tag => <span key={tag} class="px-2.5 py-1 bg-slate-100 text-slate-600 text-sm rounded-full border border-white/5 font-mono">{tag}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <article class="observe">
        <div class="prose prose-lg max-w-none">
          {(() => {
            const lines = articleContent.split(String.fromCharCode(10)).filter((l) => l.trim() !== '');
            return lines.map((line) => {
              if (line.startsWith('# ')) return <h1 key={line} class="text-3xl font-bold text-slate-900 mb-8 mt-12 first:mt-0">{line.slice(2)}</h1>;
              if (line.startsWith('## ')) return <h2 key={line} class="text-2xl font-semibold text-slate-900 mb-6 mt-10">{line.slice(3)}</h2>;
              if (line.startsWith('### ')) return <h3 key={line} class="text-xl font-semibold text-slate-900 mb-4 mt-8">{line.slice(4)}</h3>;
              if (line.startsWith('- ')) return <li key={line} class="text-slate-600 ml-6 mb-2 list-disc">{line.slice(2)}</li>;
              if (line.startsWith('*')) return <p key={line} class="text-slate-500 italic my-4">{line}</p>;
              if (line.trim() === '') return null;
              return <p key={line} class="text-slate-600 mb-4 leading-relaxed">{line}</p>;
            });
          })()}
        </div>
      </article>

      <div class="observe mt-12 pt-8 border-t border-white/5 flex gap-2 flex-wrap">
        {tags.map(tag => <span key={tag} class="px-3 py-1.5 bg-slate-100 text-slate-600 text-sm rounded-full border border-white/5">{tag}</span>)}
      </div>

      <div class="observe mt-6 flex items-center gap-4">
        <span class="text-slate-500 text-sm">{tzh('common.share')}</span>
        <button class="px-4 py-2 border border-white/10 text-slate-600 text-sm rounded-lg hover:border-blue-500 hover:text-blue-400 transition-all" onClick={() => navigator.clipboard.writeText(window.location.href)}>
          {tzh('common.copy')}
        </button>
      </div>
    </div>
  </section>
</Layout>

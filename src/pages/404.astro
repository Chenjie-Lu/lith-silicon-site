---
import Layout from '../layouts/Layout.astro';
import { t, getLocale } from '../utils/site';

const locale = getLocale();
const tzh = (key) => t(key, locale);
---

<Layout>
  <div class="min-h-[100dvh] flex items-center justify-center bg-[#070b14] pt-16">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <div class="observe">
        <h1 class="text-8xl md:text-9xl font-black text-slate-800 mb-8">404</h1>
        <p class="text-2xl md:text-3xl font-bold text-white mb-4">{locale === 'zh' ? '页面未找到' : 'Page Not Found'}</p>
        <p class="text-slate-400 text-lg mb-10">{locale === 'zh' ? '抱歉，您访问的页面不存在' : 'Sorry, the page you are looking for does not exist'}</p>
        <a href="/" class="inline-flex items-center gap-2 px-8 py-4 bg-blue-600 text-white font-semibold rounded-full hover:bg-blue-500 transition-all no-underline">
          {locale === 'zh' ? '返回首页' : 'Back to Home'}
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</Layout>
